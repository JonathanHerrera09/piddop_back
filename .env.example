NODE_ENV=development
PORT=3000
# In production set this to true only if API documentation should be public.
SWAGGER_ENABLED=false
# Set only when behind a known reverse proxy (for example: 1).
TRUST_PROXY=
# Comma-separated browser origins. Required in production (for example: https://panel.example.com).
CORS_ORIGIN=http://localhost:5174
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

DB_HOST=localhost
DB_PORT=3306
DB_NAME=allorajd
DB_USER=root
DB_PASSWORD=
# Production requires encrypted database transport. Provide the CA as a single line with \n separators.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_RESET_EXPIRES_IN_MINUTES=30

# Web OAuth client ID used as the ID-token audience for mobile Google Sign-In.
GOOGLE_OAUTH_WEB_CLIENT_ID=

SUPER_ADMIN_NAME=Platform
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_EMAIL=admin@allorajd.local
SUPER_ADMIN_PHONE=3000000000
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Servicio SMTP para correos transaccionales y pruebas desde el panel maestro.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Allora <no-reply@allora.app>"
CUSTOMER_APP_URL=https://allora.app

# Wompi. Las credenciales también pueden administrarse cifradas desde el panel SUPER_ADMIN.
WOMPI_ENABLED=false
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_PUBLIC_BASE_URL=https://api.example.com
# Llave aleatoria larga para cifrar secretos guardados en platform_settings.
# Si se omite, se usa JWT_REFRESH_SECRET como respaldo.
WOMPI_SETTINGS_ENCRYPTION_KEY=
